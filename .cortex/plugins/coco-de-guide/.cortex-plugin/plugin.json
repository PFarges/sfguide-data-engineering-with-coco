{
  "name": "coco-de-guide",
  "version": "1.0.0",
  "description": "Data engineering with CoCo guide: dbt conventions, skills, agents, and hooks for the TPCH project.",
  "author": {
    "name": "Philippe Farges",
    "email": "philippe.farges@kpconsulting.fr"
  },
  "skills": ["./skills"],
  "agents": "./agents",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"C:/Program Files/Git/bin/bash.exe\" ./.cortex/plugins/coco-de-guide/hooks/validate-bash.sh",
            "timeout": 10,
            "enabled": true,
            "statusMessage": "Checking for production dbt runs..."
          }
        ]
      }
    ]
  }
}
